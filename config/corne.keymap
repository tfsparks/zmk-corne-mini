#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define SYM 1
#define NAV 2
#define ADJ 3

// short codes
#define ___      &trans      //  transparent

#define M_CAPW LG(LS(N3))         // Capture whole screen
#define M_CPYW LG(LS(LC(N3)))  // Copy whole screen
#define M_CAPP LG(LS(N4))         // Capture portion of screen
#define M_CPYP LG(LS(LC(N4)))  // Copy portion of screen

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            label = "PARA";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            label = "PARALESS";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            label = "PARAGREAT";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <10 24>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <12 18>;
        };

        perc {
            bindings = <&kp PERCENT>;
            key-positions = <4 14>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <23 13>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <3 13>;
        };

        pound {
            bindings = <&kp POUND>;
            key-positions = <2 12>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <1 11>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <21 11>;
        };

        copy {
            bindings = <&kp K_COPY>;
            key-positions = <23 22>;
        };

        paste {
            bindings = <&kp K_PASTE>;
            key-positions = <21 22>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <7 17>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <27 17>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <6 16>;
        };

        minus {
            bindings = <&kp KP_MINUS>;
            key-positions = <26 16>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <25 15>;
        };

        leftbrack {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <26 27>;
        };

        rightbrack {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <28 27>;
        };

        para-less {
            bindings = <&paraless>;
            key-positions = <17 16>;
        };

        para-great {
            bindings = <&paragreat>;
            key-positions = <17 18>;
        };
    };

    //

    keymap {
        compatible = "zmk,keymap";

        DEF {
            display-name = "TK3";

            bindings = <
            //QWERTY
            // ╭─────────┬─────────┬─────────┬─────────┬─────────╮   ╭─────────┬─────────┬─────────┬─────────┬─────────╮
            // │    Q    │    W    │    E    │    R    │    T    │   │    Y    │    U    │    I    │    O    │    P    │
            //  &kp Q     &kp W     &kp E     &kp R     &kp T         &kp Y     &kp U     &kp I     &kp O     &kp P    
            // ├─────────┼─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┼─────────┤
            // │    A    │    S    │    D    │    F    │    G    │   │    H    │    J    │    K    │    L    │    ;    │
            //  &hm LGUI A &hm LSHFT S &hm LALT D &hm LCTRL F &kp G   &kp H     &hm RCTRL J &hm RALT K &hm RSHFT L &hm RGUI SEMI 
            // ├─────────┼─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┼─────────┤
            // │    Z    │    X    │    C    │    V    │    B    │   │    N    │    M    │   ,/;   │   ./:   │    /    │
            //  &kp Z     &kp X     &kp C     &kp V     &kp B         &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH 
            // ╰─────────┸─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┸─────────╯
            //                     │    ⎋    │    ␣    │    ⌫    │   │    →    │    ↵    │    ⌫    │
            //                      &kp LGUI  &mo 1     &kp SPACE     &kp RET   &lt 2 TAB &kp BACKSPACE
            //                     ╰─────────────────────────────╯   ╰─────────────────────────────╯
            //  >;

            // TODO: Tarmak 3 update
            // TODO: Update visual representation
            // TODO: Use keyboard-drawer

            // ╭─────────┬─────────┬─────────┬─────────┬─────────╮   ╭─────────┬─────────┬─────────┬─────────┬─────────╮
            // │    Q    │    W    │    F    │    R    │    B    │   │    Y    │    U    │    I    │    O    │    P    │
            &kp Q     &kp W     &kp F     &kp R     &kp B         &kp Y     &kp U     &kp I     &kp O     &kp P
            // ├─────────┼─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┼─────────┤
            // │    A    │    S    │    D    │    T    │    G    │   │    M    │    N    │    E    │    L    │    ;    │
            &hm LGUI A &hm LSHFT S &hm LALT D &hm LCTRL T &kp G   &kp M     &hm RCTRL N &hm RALT E &hm RSHFT L &hm RGUI SEMI
            // ├─────────┼─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┼─────────┤
            // │    Z    │    X    │    C    │    J    │    V    │   │    K    │    H    │   ,/<   │   ./>   │    /:?    │
            &kp Z     &kp X     &kp C     &kp J     &kp V         &kp K     &kp H     &kp COMMA &kp DOT   &kp FSLH
            // ╰─────────┸─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┸─────────╯
            //                     │    ⎋    │    ␣    │    ⌫    │   │    →    │    ↵    │    ⌫    │
                                    &kp ESC  &lt 1 SPACE &kp BACKSPACE &kp TAB   &lt 2 RET &kp BACKSPACE
            //                     ╰─────────────────────────────╯   ╰─────────────────────────────╯
            >;
        };

        SYM {
            // TODO: Homerow mods on symbols?

            display-name = "Sym";
            bindings = <
            // ╭─────────┬─────────┬─────────┬─────────┬─────────╮   ╭─────────┬─────────┬─────────┬─────────┬─────────╮
            // │    `    │    <    │    >    │    -    │    |    │   │    ^    │    {    │    }    │    $    │    →    │
            &kp GRAVE &kp LT    &kp GT    &kp MINUS &kp PIPE      &kp CARET &kp LBRC  &kp RBRC  &kp DLLR  &kp RPAR
            // ├─────────┼─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┼─────────┤
            // │    !    │    *    │    /    │    =    │    &    │   │    #    │    (    │    )    │    ;    │    "    │
            &kp EXCL  &kp ASTRK &kp SLASH &kp EQUAL &kp AMPS      &kp HASH  &kp LPAR  &kp RPAR     ___    &kp DQT
            // ├─────────┼─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┼─────────┤
            // │    ~    │    +    │    [    │    ]    │    %    │   │    @    │    :    │    ,    │    .    │    '    │
            &kp TILDE &kp PLUS  &kp LBKT  &kp RBKT  &kp PRCNT     &kp AT    &kp COLON   ___       ___     &kp SQT
            // ╰─────────┸─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┸─────────╯
            //                     │    ⎋    │    ␣    │    ⌫    │   │    →    │    ↵    │    ⌫    │
                                    &kp ESC  &lt 0 SPACE &kp BACKSPACE &kp TAB   &lt 2 RET &kp BACKSPACE
            //                     ╰─────────────────────────────╯   ╰─────────────────────────────╯
            >;
        };

        NAV {
            // TODO: Mouse navigation? vs mouseless?
            // TODO: Adjust Numpad config
            // TODO: Scroll events

            display-name = "Nav";
            bindings = <
            // ╭─────────┬─────────┬─────────┬─────────┬─────────╮   ╭─────────┬─────────┬─────────┬─────────┬─────────╮
            // │    F1   │   F2    │    ⏮   │    ⏯    │   ⏭    │   │    ↑    │    7    │    8    │    9    │    *    │
            &kp F1    &kp F2    &kp C_PREV &kp C_PP  &kp C_NEXT   &kp UP    &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_MULTIPLY
            // ├─────────┼─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┼─────────┤
            // │    ▭    │    ⌧    │    ↑    │    =    │   🔊    │   │    ↓    │    4    │    5    │    6    │    +    │
            &kp M_CAPP &kp M_CAPW &kp SLASH &kp EQUAL &kp C_VOL_UP &kp DOWN  &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_PLUS
            // ├─────────┼─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┼─────────┤
            // │    ⌥    │    ←    │    ↓    │    →    │   🔈    │   │    0    │    1    │    2    │    3    │    /    │
            &kp LALT &kp LEFT  &kp DOWN  &kp RIGHT &kp C_VOL_DN   &kp KP_N0 &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_DIVIDE
            // ╰─────────┸─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┸─────────╯
            //                     │    ⎋    │    ␣    │    ⌫    │   │    →    │    ↵    │    ⌫    │
                                    &kp ESC  &lt 0 SPACE &kp BACKSPACE &kp TAB   &lt 2 RET &kp BACKSPACE
            //                     ╰─────────┸─────────┸─────────╯   ╰─────────┸─────────┸─────────╯
            >;
        };

        ADJ {
            display-name = "System";
            bindings = <
            // ╭─────────┬─────────┬─────────┬─────────┬─────────╮   ╭─────────┬─────────┬─────────┬─────────┬─────────╮
            // │    F1   │    F2   │    F3   │    F4   │    F5   │   │    F6   │    F7   │    F8   │    F9   │    F10  │
            &kp F1    &kp F2    &kp F3    &kp F4    &kp F5        &kp F6    &kp F7    &kp F8    &kp F9    &kp F10
            // ├─────────┼─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┼─────────┤
            // │    F11  │    F12  │         │         │    ↺    │   │         │         │         │         │         │
            &hm LGUI F11 &hm LSHFT F12 ___   ___    &studio_unlock   ___       ___       ___       ___       ___
            // ├─────────┼─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┼─────────┤
            // │    0    │    1    │    2    │    ⊙    │    ☢    │   │         │         │         │         │    ∱    │
            &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &bt BT_CLR_ALL ___ ___       ___       ___    &bootloader
            // ╰─────────┸─────────┼─────────┼─────────┼─────────┤   ├─────────┼─────────┼─────────┼─────────┸─────────╯
            //                     │         │         │         │   │         │         │         │
                                       ___       ___       ___           ___       ___       ___
            //                     ╰─────────────────────────────╯   ╰─────────────────────────────╯
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        l3 {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
